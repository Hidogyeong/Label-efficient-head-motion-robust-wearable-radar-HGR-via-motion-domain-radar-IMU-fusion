{
  "description": "Optional 5-class check for false activation behavior with TCN backbone.",
  "continue_on_error": false,
  "defaults": {
    "num_steps": 40,
    "epochs": 80,
    "patience": 12,
    "eval_interval": 2,
    "batch_size": 512,
    "hidden": 64,
    "dropout": 0.15,

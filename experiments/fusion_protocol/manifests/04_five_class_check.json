  "folds": [0, 1, 2, 3, 4],
  "seeds": [42, 43, 44],
  "experiments": [
    {"id": "F5_radar_only_tcn", "fusion_method": "radar_only"},
    {"id": "F5_early_fusion_tcn", "fusion_method": "early_fusion"},
    {"id": "F5_late_fusion_tcn", "fusion_method": "late_fusion"},
    {"id": "F5_attention_fusion_tcn", "fusion_method": "attention_fusion"},
    {"id": "F5_motion_domain_proposed_tcn", "fusion_method": "motion_domain_proposed"}
  ]
}

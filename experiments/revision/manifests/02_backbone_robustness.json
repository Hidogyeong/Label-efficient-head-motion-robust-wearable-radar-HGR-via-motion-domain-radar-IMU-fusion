{
  "description": "Backbone robustness: selected fusion strategies across TCN, GRU, and Transformer.",
  "continue_on_error": false,
  "defaults": {
    "num_steps": 40,
    "epochs": 80,
    "patience": 12,
    "eval_interval": 2,
    "batch_size": 512,
    "hidden": 64,
    "dropout": 0.15,
    "lr": 0.0005,
    "weight_decay": 0.0001,
    "scheduler_patience": 6,
    "augment": true,
    "class_mode": 4,
    "protocol": "mixed_budget"
  },
  "folds": [0, 1, 2, 3, 4],
  "seeds": [42, 43, 44],
  "experiments": [
    {"id": "B_radar_only_tcn", "fusion_method": "radar_only", "backbone": "tcn"},
    {"id": "B_early_fusion_tcn", "fusion_method": "early_fusion", "backbone": "tcn"},
    {"id": "B_motion_domain_tcn", "fusion_method": "motion_domain_proposed", "backbone": "tcn"},

    {"id": "B_radar_only_gru", "fusion_method": "radar_only", "backbone": "gru"},
    {"id": "B_early_fusion_gru", "fusion_method": "early_fusion", "backbone": "gru"},
    {"id": "B_motion_domain_gru", "fusion_method": "motion_domain_proposed", "backbone": "gru"},

    {"id": "B_radar_only_transformer", "fusion_method": "radar_only", "backbone": "transformer"},
    {"id": "B_early_fusion_transformer", "fusion_method": "early_fusion", "backbone": "transformer"},
    {"id": "B_motion_domain_transformer", "fusion_method": "motion_domain_proposed", "backbone": "transformer"}
  ]
}
